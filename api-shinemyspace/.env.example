# ============================================================
#  api-shinemyspace — environment variables
#  Copy to `.env` for local dev; set the same keys in Render for production.
#  Never commit the real `.env` (it's gitignored).
# ============================================================

# ── Express ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000                       # Render sets this automatically; local uses 3000

# ── CORS ────────────────────────────────────────────────
# The frontend site allowed to call this API (production only; dev is open).
# Change if the frontend domain changes.
CORS_ORIGIN=https://estimator.shinemyspace.com

# ── Google Sign-In ──────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
# Comma-separated team emails allowed to sign in. EDIT to add/remove salespeople.
ALLOWED_EMAILS=salesman1@gmail.com,salesman2@gmail.com

# ── Zoho Books (India data center) ──────────────────────
ZOHO_CLIENT_ID=1000.xxxxx
ZOHO_CLIENT_SECRET=xxxxx
ZOHO_REFRESH_TOKEN=1000.xxxxx
ZOHO_ORG_ID=60068893664
# The Zoho contact every estimate is created against (the "system customer").
ZOHO_SYSTEM_CONTACT_ID=3618818000000038007
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in/books/v3
# Base URL of the Zoho Books web app (used to build the estimate link).
ZOHO_BOOKS_URL=https://books.zoho.in

# ── Optional tuning (sensible defaults if omitted) ──────
# How long items are cached before re-fetching from Zoho (minutes).
ITEMS_CACHE_MINUTES=60
# Reference number prefix. Blank = no reference number; set e.g. EST for EST-1721400000000.
ESTIMATE_REF_PREFIX=

# ── Local testing only — NEVER set in production ────────
# DISABLE_AUTH=1   # bypass Google verification for Postman; ignored when NODE_ENV=production
