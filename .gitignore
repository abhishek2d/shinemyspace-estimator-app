# ── Dependencies ──────────────────────────────────────
node_modules/

# ── Secrets: never commit real credentials ────────────
# Ignore every .env variant, but keep the committed template .env.example.
.env
.env.*
!.env.example

# ── Local tooling / editor config (personal, not for the repo) ──
.claude/settings.local.json
.vscode/
.idea/

# ── Generated artifacts ───────────────────────────────
# The prod-ready frontend upload folder is generated by make-frontend-upload.sh
# (a copy of the frontend) — don't commit the duplicate; regenerate it instead.
estimator-shinemyspace upload/
# Temp folder built for a manual Hostinger upload; safe to delete after deploy.
# Ignored so a duplicate of the frontend can never be committed by accident.
estimator-ui-upload-temp/

# ── OS / editor cruft ─────────────────────────────────
.DS_Store
Thumbs.db
*.log
npm-debug.log*
